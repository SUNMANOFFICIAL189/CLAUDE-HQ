{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.13/bin/code-review-graph update --repo /Users/sunil_rajput/claude-hq --skip-flows >/dev/null 2>>/Users/sunil_rajput/.claude/logs/crg-hook.err || true",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Library/Frameworks/Python.framework/Versions/3.13/bin/code-review-graph status 2>>/Users/sunil_rajput/.claude/logs/crg-hook.err || true",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/Users/sunil_rajput/claude-hq/watchdog/hooks/session-end.sh",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
