+"""Regression tests for the HQ pilot Anthropic/Claude-Code credential fence.
+
+Written against skills/hq-hermes/reviews/proof-check-2026-09-03.md (Wave 3,
+ticket T3e) so a future change cannot silently reopen H1/H2/H4/M7 without a
+test going red. Widened in T3f (proof-check-rerun-2026-09-03.md) to cover
+NEW-1/NEW-2 and the H3 import-fallback path. stdlib ``unittest`` only -- no
+pytest, no network, no real credentials. Run with::
+
+    cd "$CO" && ./.venv/bin/python -m unittest tests.hq_pilot.test_fence -v
+"""
+
+import collections
+import os
+import re
+import sys
+import types
+import unittest
+from pathlib import Path
+from unittest.mock import patch
+
+REPO_ROOT = Path(__file__).resolve().parents[2]
+
