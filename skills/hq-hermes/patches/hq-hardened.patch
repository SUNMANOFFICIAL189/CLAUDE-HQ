+class TestNewTwoProbeAnthropicDisabled(unittest.TestCase):
+    """NEW-2 (proof-check-rerun-2026-09-03.md): ``doctor.py``'s
+    ``_probe_anthropic`` sends a raw httpx request straight to
+    api.anthropic.com using whatever ``get_anthropic_key()`` returns -- an
+    OAuth-shaped value surviving in ``ANTHROPIC_API_KEY``/``.env`` rode
+    through this probe even with the H1 client-builder fence up, because H1
+    guards the outbound client builders, not this standalone connectivity
+    check. Must return the disabled/no-op row and never call the HTTP
+    client at all.
+
+    ``_probe_anthropic`` is a closure nested inside ``run_doctor()`` (it
+    shares a locally-defined ``_ConnectivityResult`` namedtuple with sibling
+    probes, by design -- see the "Refactor" comment above ``_probe_openrouter``
+    in doctor.py), so it has no importable module-level name. Rather than
+    duplicate its guard logic in a test double (which could silently drift
+    from the real code) or run the entire multi-thousand-line ``run_doctor()``
+    end-to-end, this extracts the REAL compiled function straight out of
+    ``run_doctor.__code__.co_consts`` and rebinds it with a stand-in closure
+    cell for its one free variable -- the same "reconstruct a function from
+    ``__code__``" technique already used in this repo's own test suite (see
+    ``tests/cli/test_handoff_slow_dispatch_timeout.py``'s ``types.FunctionType``
+    rebind), extended one level to reach a function that was never itself
+    reachable as an attribute."""
+
+    @staticmethod
+    def _extract_probe_anthropic():
+        from hermes_cli import doctor as doctor_mod
+
+        target_code = None
+        for const in doctor_mod.run_doctor.__code__.co_consts:
+            if isinstance(const, types.CodeType) and const.co_name == "_probe_anthropic":
+                target_code = const
+                break
+        if target_code is None:
+            raise AssertionError(
+                "could not locate the _probe_anthropic nested code object "
+                "inside hermes_cli.doctor.run_doctor -- has it been renamed "
+                "or moved to module level?"
+            )
+        if target_code.co_freevars != ("_ConnectivityResult",):
+            raise AssertionError(
+                "_probe_anthropic's free variables changed shape "
+                f"(expected exactly ('_ConnectivityResult',), got "
+                f"{target_code.co_freevars}) -- update this test's closure "
+                "construction to match"
+            )
+        connectivity_result = collections.namedtuple(
+            "_ConnectivityResult", ["label", "lines", "issues"]
+        )
+        closure = (types.CellType(connectivity_result),)
+        return types.FunctionType(
+            target_code, doctor_mod.__dict__, "_probe_anthropic", None, closure
+        )
+
+    def test_probe_anthropic_returns_disabled_row_and_never_calls_httpx(self):
+        probe_anthropic = self._extract_probe_anthropic()
+
+        fake_env = {"ANTHROPIC_API_KEY": "cc-fake-oauth-token"}
+        with patch.dict(os.environ, fake_env, clear=False):
+            with patch("httpx.get") as mock_httpx_get:
+                result = probe_anthropic()
+
+        mock_httpx_get.assert_not_called()
+        self.assertEqual(result.label, "Anthropic API")
+        self.assertEqual(result.lines, [])
+        self.assertEqual(result.issues, [])
+
+
