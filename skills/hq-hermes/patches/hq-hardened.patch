+class TestSingleGuardDefinition(unittest.TestCase):
+    """M7: exactly one ``HQ_PILOT_ANTHROPIC_DISABLED = `` assignment across
+    the whole guarded tree -- three independent copies used to exist
+    (anthropic_credentials, anthropic_adapter, credential_pool); a partial
+    flip of one produced a half-open fence with no error. Mirrors the
+    ticket's shell grep, done in Python so it runs inside the same test
+    process.
+
+    Widened past ``agent/`` alone (proof-check-rerun-2026-09-03.md, T3f):
+    this same ticket imports the guard into ``hermes_cli/`` (runtime_provider.py,
+    model_setup_flows.py, models.py, doctor.py) and ``tools/`` (environments/
+    local.py) too, so those trees need the same "exactly one" floor."""
+
+    SCAN_DIRNAMES = ("agent", "hermes_cli", "tools")
+
+    def test_exactly_one_guard_definition(self):
+        pattern = re.compile(r"^HQ_PILOT_ANTHROPIC_DISABLED = ")
+        scan_dirs = [REPO_ROOT / name for name in self.SCAN_DIRNAMES]
+        for d in scan_dirs:
+            self.assertTrue(d.is_dir(), f"expected {d} to exist")
+
+        matches = []
+        for base_dir in scan_dirs:
+            for path in base_dir.rglob("*.py"):
+                if ".venv" in path.parts or "tests" in path.parts:
+                    continue
+                try:
+                    text = path.read_text(encoding="utf-8", errors="replace")
+                except OSError:
+                    continue
+                for lineno, line in enumerate(text.splitlines(), start=1):
+                    if pattern.match(line):
+                        matches.append(f"{path}:{lineno}")
+
+        self.assertEqual(
+            len(matches), 1,
+            f"expected exactly one HQ_PILOT_ANTHROPIC_DISABLED definition "
+            f"under {[str(d) for d in scan_dirs]}, found {len(matches)}: {matches}",
+        )
+        self.assertIn("anthropic_credentials.py", matches[0])
