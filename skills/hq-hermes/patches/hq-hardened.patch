+class TestGuardImportFallbackFailsClosed(unittest.TestCase):
+    """H3 fallback: when ``from agent.anthropic_credentials import
+    HQ_PILOT_ANTHROPIC_DISABLED`` itself raises ImportError, every fallback
+    site must resolve to disabled=True (fail closed), never disabled=False
+    (fail open). Simulates the unimportable guard module by placing ``None``
+    in ``sys.modules`` under its dotted name -- the standard trick for
+    forcing ``ImportError`` at an exact import statement, per Python import
+    system semantics (a ``None`` entry make the import machinery raise
+    immediately) -- then calls one real fallback site directly:
+    ``tools.environments.local._build_provider_env_blocklist()``, which
+    tests the H3 fallback that discards ``CLAUDE_CODE_OAUTH_TOKEN`` from the
+    blocklist only when the guard resolves to NOT disabled."""
+
+    def test_build_provider_env_blocklist_fails_closed_on_unimportable_guard(self):
+        from tools.environments.local import _build_provider_env_blocklist
+
+        with patch.dict(sys.modules, {"agent.anthropic_credentials": None}):
+            blocked = _build_provider_env_blocklist()
+
+        # Fail-closed means the discard never ran: the token stays blocked.
+        self.assertIn(
+            "CLAUDE_CODE_OAUTH_TOKEN", blocked,
+            "guard import failure did not fail closed -- "
+            "CLAUDE_CODE_OAUTH_TOKEN was discarded from the blocklist",
+        )
