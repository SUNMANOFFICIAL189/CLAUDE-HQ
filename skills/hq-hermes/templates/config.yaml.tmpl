# HQ Hermes pilot — hardened config.yaml template (T8, PLAN v2.1l).
# Rendered by $SK/scripts/pilot/render-config.sh {ollama|groq} — never hand-edit
# the rendered $HH/config.yaml; edit this template and re-render.
#
# Placeholders (filled by the renderer, bash+sed only) -- written here with a
# space before the second "at" pair so this comment block itself is not
# rewritten by the renderer's own substitution passes:
#   MODEL token          (a @ @MODEL@ @ marker) - model.default / delegation.model /
#                          every auxiliary.*.model
#   BASE_URL token        (a @ @BASE_URL@ @ marker) - model.base_url
#   SECRETS_ENABLED token (a @ @SECRETS_ENABLED@ @ marker) - secrets.command.enabled (bare true/false)
#   KEY_ENV_BLOCK token   (a @ @KEY_ENV_BLOCK@ @ marker) - whole-line marker; deleted
#                          for ollama (no key needed), replaced with a providers:
#                          block for groq
#
# Keys set here are EXACTLY the T8 (PLAN v2.1l) list plus T8b's
# _config_version stamp, plus T8c-B's full 18-surface auxiliary pin set and
# the four explicit terminal mount keys — nothing else.
#
# HQ pilot T8c-B (proof-check-s3-rerun-2026-09-04.md NEW HIGH): the T8/T8b
# auxiliary block pinned only 8 of the 18 real DEFAULT_CONFIG["auxiliary"]
# sub-dicts with a "provider" key (vision, compression, skills_hub, approval,
# review, mcp, title_generation, memory_query_rewrite, tts_audio_tags,
# triage_specifier, kanban_decomposer, profile_describer, goal_judge,
# curator, monitor, background_review, moa_reference, moa_aggregator — 18
# total); the other 10 silently resolved to provider "auto". web_extract and
# session_search are retired upstream (no longer auxiliary-LLM tasks;
# DEFAULT_CONFIG carries only a comment where their blocks used to be) and
# are dropped here rather than pinned. The four terminal keys
# (docker_mount_cwd_to_workspace / docker_persist_across_processes /
# docker_volumes / docker_extra_args) make explicit what PLAN §1.2 already
# requires in practice (the job workdir is the only bind-mount; Hermes runs
# with cwd = the job dir; no other volumes; no extra docker flags; no
# container reuse across processes) instead of leaving them at
# DEFAULT_CONFIG's implicit defaults.

# HQ pilot T8b (proof-check-s3-2026-09-04.md HIGH-3): pin the schema version
# this template was written against so a first real `hermes chat`'s
# migrate_config()/_persist_migration()/save_config() ladder (which strips
# default-equal keys on write) does not silently turn "Config version
# outdated" into a new steady state the C1/C1b fence audits stop matching.
# Value = latest_ver from check_config_version() at authoring time
# (read-only; never re-derived by the renderer itself).
_config_version: 39

model:
  provider: "custom"
  base_url: "@@BASE_URL@@"
  default: "@@MODEL@@"
  context_length: 65536
  ollama_num_ctx: 65536

agent:
  max_turns: 40

delegation:
  max_concurrent_children: 1
  max_spawn_depth: 1
  provider: "custom"
  model: "@@MODEL@@"

approvals:
  mode: "manual"
  single_query_mode: "deny"
  cron_mode: "deny"
  unattended_mode: "deny"
  deny:
    - "git push*"
    - "curl*"
    - "wget*"
    - "pip *"
    - "pip3 *"
    - "uv pip*"
    - "npm *"
    - "brew *"
    - "osascript*"
    - "sudo *"
    - "hermes *"
    - "ollama *"
    - "docker *"
    - "ssh *"
    - "scp *"
    - "security *"

memory:
  write_approval: true

skills:
  write_approval: true
  guard_agent_created: true

terminal:
  backend: "docker"
  docker_image: "hermes-pilot:v1"
  container_memory: 2048
  container_persistent: false
  docker_network: false
  docker_forward_env: []
  docker_mount_cwd_to_workspace: true
  docker_persist_across_processes: false
  docker_volumes: []
  docker_extra_args: []

telemetry:
  shared_metrics:
    enabled: false

auxiliary:
  free_only: true
  # All 18 DEFAULT_CONFIG["auxiliary"] sub-dicts that carry a "provider" key
  # (T8c-B; web_extract/session_search excluded -- retired upstream, no
  # longer auxiliary-LLM tasks). Order matches config_defaults.py.
  vision:
    provider: "custom"
    model: "@@MODEL@@"
  compression:
    provider: "custom"
    model: "@@MODEL@@"
  skills_hub:
    provider: "custom"
    model: "@@MODEL@@"
  approval:
    provider: "custom"
    model: "@@MODEL@@"
  review:
    provider: "custom"
    model: "@@MODEL@@"
  mcp:
    provider: "custom"
    model: "@@MODEL@@"
  title_generation:
    provider: "custom"
    model: "@@MODEL@@"
    enabled: false
  memory_query_rewrite:
    provider: "custom"
    model: "@@MODEL@@"
  tts_audio_tags:
    provider: "custom"
    model: "@@MODEL@@"
  triage_specifier:
    provider: "custom"
    model: "@@MODEL@@"
  kanban_decomposer:
    provider: "custom"
    model: "@@MODEL@@"
  profile_describer:
    provider: "custom"
    model: "@@MODEL@@"
  goal_judge:
    provider: "custom"
    model: "@@MODEL@@"
  curator:
    provider: "custom"
    model: "@@MODEL@@"
  monitor:
    provider: "custom"
    model: "@@MODEL@@"
  background_review:
    provider: "custom"
    model: "@@MODEL@@"
    enabled: false
  moa_reference:
    provider: "custom"
    model: "@@MODEL@@"
  moa_aggregator:
    provider: "custom"
    model: "@@MODEL@@"

context_file_max_chars: 20000

secrets:
  command:
    enabled: @@SECRETS_ENABLED@@
    command: "/Users/sunil_rajput/claude-hq/run/pilot-tree/skills/hq-hermes/scripts/hermes-secrets.sh"
    helper_timeout_seconds: 5

hooks: []
@@KEY_ENV_BLOCK@@
